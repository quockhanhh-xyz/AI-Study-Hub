# ==============================================================================
# AI Study Hub - Environment Variables Template (.env.example)
# ==============================================================================

# Database Configuration (MySQL)
DB_URL=jdbc:mysql://localhost:3306/ai_study_hub?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
DB_USERNAME=root
DB_PASSWORD=yourpasswordhere

# Security Configuration (JWT)
JWT_SECRET=yoursecretjwtkeywhichneedstobelongenoughatleast256bits12345
JWT_EXPIRATION_MS=86400000

# Gmail SMTP Configuration
GMAIL_USERNAME=example@gmail.com
GMAIL_APP_PASSWORD=yourgmailapppasswordhere

# Cloudinary Storage Configuration
CLOUDINARY_ENABLED=false
CLOUDINARY_CLOUD_NAME=yourcloudnamehere
CLOUDINARY_API_KEY=yourapikeyhere
CLOUDINARY_API_SECRET=yourapisecrethere

# AI Provider Configuration
AI_PROVIDER=mock
GEMINI_API_KEY=yourgeminiapikeyhere
GEMINI_MODEL_FREE=gemini-2.5-flash-lite
GEMINI_MODEL_PREMIUM=gemini-2.5-flash
GEMINI_MODEL_ULTRA=gemini-2.5-flash

# Payment Configuration (Step 13B)
# Enable/Disable Mock Payment Provider (Set to false for strict sandbox-only testing)
PAYMENT_MOCK_ENABLED=true

# Frontend Payment Result Redirect Target (Where Return URL redirects)
FRONTEND_PAYMENT_RESULT_URL=http://localhost:5500/frontend/payment-result.html

# VNPay Sandbox Gateway Configuration
VNPAY_ENABLED=true
VNPAY_TMN_CODE=yourvnpaytmncodehere
VNPAY_HASH_SECRET=yourvnpayhashsecrethere
VNPAY_PAYMENT_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=http://localhost:8080/api/payments/vnpay/return
# IPN URL must be a public HTTPS URL (e.g. ngrok address) during sandbox testing, not localhost
VNPAY_IPN_URL=https://your-public-ngrok-subdomain.ngrok-free.app/api/payments/vnpay/ipn

